(*
 * Ylwa Benchmark Representation — EBNF Specification
 * Ylwa is a string-only format used for logs and benchmark results.
 *)

(* ===== TERMINALS ===== *)

LETTER  = "A".."Z" | "a".."z" ;
DIGIT   = "0".."9" ;
WS      = " " | "\t" | "\n" | "\r" ;
SYMBOL  = "!" | "\"" | "#" | "$" | "%" | "&" | "'" | "(" | ")" |
          "*" | "+" | "," | "-" | "." | "/" | ":" | ";" | "<" |
          "=" | ">" | "?" | "@" | "[" | "]" | "^" | "_" | "`" |
          "{" | "|" | "}" | "~" ;

ANY     = LETTER | DIGIT | SYMBOL | WS ;

ident   = LETTER, { LETTER | DIGIT | "_" } ;

(* Value in Ylwa is always a raw string until the comma *)
value-char = ANY - "," ;
value      = { value-char } ;

(* ===== STRUCTURES ===== *)

(* Header: .> Title <. *)
header = ".>", { ANY - "<" }, "<." ;

(* Comment Block: .> ... <. *)
comment = ".>", { ANY - "." | (".", ANY - "<") }, ".<" ;

(* Field: - Key ; Value, *)
field = "-", ident, ";", value, ",", { WS }, [ comment ] ;

(* Block: ~ Name : ... : *)
block = "~", ident, ":", { field | comment | WS }, ":" ;

(* File Structure *)
ylwa-item = header | comment | block | WS ;
ylwa-file = { ylwa-item } ;
