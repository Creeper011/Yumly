;> an include <;
include { ".env" }

;> you can use too:
include { "file.yumly" }
<;

;> globals <;
@specialNumber ;int = 67
@globalEnv ;env = $["HOME"]

;> full names interpolates to a string <;
name ;string = "John Doe", fullName ;string = !"John Doe @specialNumber!",
age ;int = 30
hobbies ;list[string] = ["reading", "hiking", "cooking"]
homeDir ;env = @globalEnv

;> an commentary <;
;>
multiple line
commentary
<;

(block1) {
    variable1 ;string = "value",
    variable2 ;int = 1,
    variable3 ;list[int] = [1, 2, 3, 4, 5],
    variable4 ;list[string] = ["one", "two", "three", "four", "five"],
    variable5 = [1, "two", 3.3, "four", ["five"]],
    variable6 ;string = "string with a \"quote\" inside and a \\ backslash inside"
}
