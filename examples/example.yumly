;> Main Example configuration for Big Cid <;

include { ".env" }

(application) {
    name ;string = "Big Cid"
    version ;string = "1.5.6", valid ;bool = true

    description ;string = """
    Big Cid is a big project about Cid.
    Forget Alexa. Forget humanoid robots.
    Forget everything else.
    JUST BIG CID!!
    """

    (services) {
        main-token ;env = $["MAIN_TOKEN"],
    }
}