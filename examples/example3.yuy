;> include { ".env" } we don't use it, because the variables are already exported in the shell environment <;
include { "example2.yumly" }

(linux_system) {
    path ;env = $["PATH" ?? "mocked"],
    home ;env = $["HOME" ?? "mocked"],
    shell ;env = $["SHELL" ?? "mocked"],
    user ;env = $["USER" ?? "mocked"],
    uh ;env = $["UH" ?? "mocked"]
}