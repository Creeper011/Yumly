;> Test file metadata for recursion limit failure <;

name ;string = "Parser Recursion Limit"
valid ;bool = false, number ;int = 0002
expectedCode ;string = "parser.recursion-limit"

cases ;list[string] = ["case1.yumly"]

preSuiteEval ;string = """
from pathlib import Path

constants_path = Path("../../../..") / "src" / "Yumly" / "constants.nim"
for line in constants_path.read_text().splitlines():
    if line.startswith("const MaxRecursionDepth*"):
        max_depth = int(line.rsplit("=", 1)[1].strip())
        break
else:
    raise RuntimeError("MaxRecursionDepth not found")

levels = max_depth + 1
body = ""
for i in range(1, levels + 1):
    body += f"(level{i}) {{\\n"
for i in range(1, levels + 1):
    body += "}\\n"
with open("case1.yumly", "w") as f:
    f.write(body)
"""
