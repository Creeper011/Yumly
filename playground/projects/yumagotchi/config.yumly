;> Main configuration yumagotchi <;

[action] {
  name ;string
  key ;string
  fullness ;int
  happiness ;int
  energy ;int
  messages ;list[string]
}

[mood] {
  threshold ;int
  message ;string
}

(pet) {
  name = "Yummie"

  (initial-stats) {
    fullness ;int = 72
    happiness ;int = 80
    energy ;int = 64
  }
}

